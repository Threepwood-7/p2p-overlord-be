generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

model File {
  id          BigInt   @id @default(autoincrement())
  size        BigInt?
  firstSeen   DateTime @default(now())
  lastSeen    DateTime @default(now())
  names       FileName[]
  hashes      FileHash[]
  tags        FileTag[]
  sources     Source[]
  searchLinks SearchResult[]
}

model FileHash {
  hashType  String
  hashValue String
  fileId    BigInt
  file      File   @relation(fields: [fileId], references: [id], onDelete: Cascade)

  @@id([hashType, hashValue])
}

model FileName {
  id        BigInt   @id @default(autoincrement())
  fileId    BigInt
  name      String
  firstSeen DateTime @default(now())
  file      File     @relation(fields: [fileId], references: [id], onDelete: Cascade)

  @@unique([fileId, name])
}

model FileTag {
  id      BigInt @id @default(autoincrement())
  fileId  BigInt
  key     String
  value   Json
  file    File   @relation(fields: [fileId], references: [id], onDelete: Cascade)
}

model Source {
  id        BigInt   @id @default(autoincrement())
  fileId    BigInt
  protocol  String
  address   String
  extra     Json
  seenAt    DateTime @default(now())
  file      File     @relation(fields: [fileId], references: [id], onDelete: Cascade)
}

model SearchJob {
  id                String         @id
  protocol          String
  kind              String
  query             String?
  fileHash          Json?
  fileSize          BigInt?
  status            String
  resultCount       Int            @default(0)
  lastError         String?
  createdAt         DateTime       @default(now())
  startedAt         DateTime?
  finishedAt        DateTime?
  cancelRequestedAt DateTime?
  dispatches        SearchDispatch[]
  results           SearchResult[]
}

model SearchDispatch {
  id          BigInt    @id @default(autoincrement())
  jobId       String
  indexerId   String
  status      String
  resultCount Int       @default(0)
  batchCount  Int       @default(0)
  lastError   String?
  createdAt   DateTime  @default(now())
  startedAt   DateTime?
  finishedAt  DateTime?
  job         SearchJob @relation(fields: [jobId], references: [id], onDelete: Cascade)

  @@unique([jobId, indexerId])
}

model SearchResult {
  jobId      String
  fileId     BigInt
  seenCount  Int      @default(1)
  firstSeen  DateTime @default(now())
  lastSeen   DateTime @default(now())
  job        SearchJob @relation(fields: [jobId], references: [id], onDelete: Cascade)
  file       File      @relation(fields: [fileId], references: [id], onDelete: Cascade)

  @@id([jobId, fileId])
}

model SnoopEntry {
  indexerId  String
  query      String
  hash       Json?
  hitCount   Int
  firstSeen  DateTime
  lastSeen   DateTime
  lastDrainedAt DateTime?

  @@unique([indexerId, query])
}

model SnoopLog {
  id        BigInt   @id @default(autoincrement())
  query     String
  hash      Json?
  hitCount  Int
  seenAt    DateTime @default(now())
}

model StatsSample {
  id                BigInt   @id @default(autoincrement())
  indexerId         String
  protocol          String
  peersConnected    Int
  crawlRate         Float
  snoopQueueDepth   Int
  stagingQueueDepth Int
  uptimeSecs        BigInt
  createdAt         DateTime @default(now())
}

model IndexerRegistry {
  id           String   @id
  protocol     String
  url          String
  hostname     String
  version      String
  registeredAt DateTime @default(now())
}

model RawHash {
  hashType     String
  hashValue    String
  protocol     String
  firstSeen    DateTime @default(now())
  status       String   @default("pending")

  @@id([hashType, hashValue])
}
